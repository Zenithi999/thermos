# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Older projects: use the "anon" key instead of the publishable key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...ewn